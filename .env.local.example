
# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenRouter API Configuration
# Used for AI-powered features. Get your API key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Resend API Configuration
# Used for email notifications. Get your API key from: https://resend.com/api-keys
# NOTE: This should be set in Supabase Edge Function secrets, not in this file
# Set using: supabase secrets set RESEND_API_KEY=re_...
# For development, you can use Resend's test mode with domain: resend.dev
# For production, verify your domain at: https://resend.com/domains
# RESEND_API_KEY=re_your_resend_api_key_here

# Railway static URL (for production)
VITE_PUBLIC_URL=your_railway_url_here

# Sentry Configuration
# Error tracking and performance monitoring. Get your DSN from: https://sentry.io/
VITE_SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project_id

# Sentry Build Configuration (for source maps upload)
# Only needed for CI/CD and production builds
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=pt2030-candidaturas

# Posthog Configuration
# Product analytics and user behavior tracking. Get your key from: https://app.posthog.com/project/settings
# For EU GDPR compliance, use the EU instance at https://eu.posthog.com
VITE_POSTHOG_KEY=phc_your_posthog_key_here
